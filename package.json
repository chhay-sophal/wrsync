{
  "name": "wrsync",
  "displayName": "Web Resource Sync",
  "description": "Edit Power Apps (Dataverse) web resources from local files, right inside VS Code",
  "version": "0.0.2",
  "publisher": "sophal-developer",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chhay-sophal/wrsync.git"
  },
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "power apps",
    "power platform",
    "dataverse",
    "dynamics 365",
    "web resources"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wrsync.signIn",
        "title": "Sign In",
        "category": "Web Resource Sync",
        "icon": "$(sign-in)"
      },
      {
        "command": "wrsync.signInToTenant",
        "title": "Sign In to Another Tenant...",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.signOut",
        "title": "Sign Out",
        "category": "Web Resource Sync",
        "icon": "$(sign-out)"
      },
      {
        "command": "wrsync.showAuthStatus",
        "title": "Show Sign-in Status",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.pickEnvironment",
        "title": "Pick Environment...",
        "category": "Web Resource Sync",
        "icon": "$(cloud)"
      },
      {
        "command": "wrsync.pickSolution",
        "title": "Pick Solution...",
        "category": "Web Resource Sync",
        "icon": "$(package)"
      },
      {
        "command": "wrsync.refresh",
        "title": "Refresh",
        "category": "Web Resource Sync",
        "icon": "$(refresh)"
      },
      {
        "command": "wrsync.createWebResource",
        "title": "Create Web Resource...",
        "category": "Web Resource Sync",
        "icon": "$(new-file)"
      },
      {
        "command": "wrsync.suggestLinks",
        "title": "Suggest Links...",
        "category": "Web Resource Sync",
        "icon": "$(sparkle)"
      },
      {
        "command": "wrsync.filterTypes",
        "title": "Filter by Type...",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.filterManaged",
        "title": "Filter by Managed State...",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.showModifiedOnly",
        "title": "Show Modified Only",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.showAllNotOnlyModified",
        "title": "Show Modified Only ✓",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.showLinkedOnly",
        "title": "Show Linked Only",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.showAllNotOnlyLinked",
        "title": "Show Linked Only ✓",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.showUnlinkedOnly",
        "title": "Show Unlinked Only",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.showAllNotOnlyUnlinked",
        "title": "Show Unlinked Only ✓",
        "category": "Web Resource Sync"
      },
      {
        "command": "wrsync.clearFilters",
        "title": "Clear Filters",
        "category": "Web Resource Sync",
        "icon": "$(clear-all)"
      },
      {
        "command": "wrsync.sortBy",
        "title": "Sort By...",
        "category": "Web Resource Sync",
        "icon": "$(list-ordered)"
      },
      {
        "command": "wrsync.link",
        "title": "Link to Local File...",
        "category": "Web Resource Sync",
        "icon": "$(link)"
      },
      {
        "command": "wrsync.unlink",
        "title": "Unlink Local File",
        "category": "Web Resource Sync",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "wrsync.publish",
        "title": "Publish",
        "category": "Web Resource Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "wrsync.publishSelected",
        "title": "Publish Selected",
        "category": "Web Resource Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "wrsync.pull",
        "title": "Pull (Replace Local File)",
        "category": "Web Resource Sync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "wrsync.compare",
        "title": "Compare with Local File",
        "category": "Web Resource Sync",
        "icon": "$(diff)"
      },
      {
        "command": "wrsync.viewContent",
        "title": "View Content",
        "category": "Web Resource Sync",
        "icon": "$(eye)"
      },
      {
        "command": "wrsync.openLocalFile",
        "title": "Open Local File",
        "category": "Web Resource Sync",
        "icon": "$(go-to-file)"
      },
      {
        "command": "wrsync.showDetails",
        "title": "Show Details",
        "category": "Web Resource Sync",
        "icon": "$(info)"
      },
      {
        "command": "wrsync.publishCurrentFile",
        "title": "Publish This File",
        "icon": "$(cloud-upload)",
        "category": "Web Resource Sync"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wrsync",
          "title": "Web Resource Sync",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wrsync": [
        {
          "id": "wrsync.webResources",
          "name": "Web Resources",
          "contextualTitle": "Web Resource Sync",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "wrsync.publishCurrentFile",
          "when": "wrsync.activeFileLinked && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "wrsync.filter": [
        {
          "command": "wrsync.filterTypes",
          "group": "1_filter@1"
        },
        {
          "command": "wrsync.filterManaged",
          "group": "1_filter@2"
        },
        {
          "command": "wrsync.showModifiedOnly",
          "group": "1_filter@3",
          "when": "!wrsync.modifiedOnly"
        },
        {
          "command": "wrsync.showAllNotOnlyModified",
          "group": "1_filter@3",
          "when": "wrsync.modifiedOnly"
        },
        {
          "command": "wrsync.showLinkedOnly",
          "group": "1_filter@4",
          "when": "wrsync.linkFilter != linked"
        },
        {
          "command": "wrsync.showAllNotOnlyLinked",
          "group": "1_filter@4",
          "when": "wrsync.linkFilter == linked"
        },
        {
          "command": "wrsync.showUnlinkedOnly",
          "group": "1_filter@5",
          "when": "wrsync.linkFilter != unlinked"
        },
        {
          "command": "wrsync.showAllNotOnlyUnlinked",
          "group": "1_filter@5",
          "when": "wrsync.linkFilter == unlinked"
        },
        {
          "command": "wrsync.clearFilters",
          "group": "2_clear",
          "when": "wrsync.filtersActive"
        }
      ],
      "wrsync.filterActive": [
        {
          "command": "wrsync.filterTypes",
          "group": "1_filter@1"
        },
        {
          "command": "wrsync.filterManaged",
          "group": "1_filter@2"
        },
        {
          "command": "wrsync.showModifiedOnly",
          "group": "1_filter@3",
          "when": "!wrsync.modifiedOnly"
        },
        {
          "command": "wrsync.showAllNotOnlyModified",
          "group": "1_filter@3",
          "when": "wrsync.modifiedOnly"
        },
        {
          "command": "wrsync.showLinkedOnly",
          "group": "1_filter@4",
          "when": "wrsync.linkFilter != linked"
        },
        {
          "command": "wrsync.showAllNotOnlyLinked",
          "group": "1_filter@4",
          "when": "wrsync.linkFilter == linked"
        },
        {
          "command": "wrsync.showUnlinkedOnly",
          "group": "1_filter@5",
          "when": "wrsync.linkFilter != unlinked"
        },
        {
          "command": "wrsync.showAllNotOnlyUnlinked",
          "group": "1_filter@5",
          "when": "wrsync.linkFilter == unlinked"
        },
        {
          "command": "wrsync.clearFilters",
          "group": "2_clear",
          "when": "wrsync.filtersActive"
        }
      ],
      "view/title": [
        {
          "command": "wrsync.publishSelected",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution && wrsync.selectionHasSyncable",
          "group": "navigation@0"
        },
        {
          "command": "wrsync.createWebResource",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution",
          "group": "navigation@1"
        },
        {
          "command": "wrsync.suggestLinks",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution",
          "group": "navigation@2"
        },
        {
          "command": "wrsync.refresh",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution",
          "group": "navigation@3"
        },
        {
          "submenu": "wrsync.filter",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution && !wrsync.filtersActive",
          "group": "navigation@4"
        },
        {
          "submenu": "wrsync.filterActive",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution && wrsync.filtersActive",
          "group": "navigation@4"
        },
        {
          "command": "wrsync.sortBy",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution",
          "group": "1_view@1"
        },
        {
          "command": "wrsync.clearFilters",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasSolution && wrsync.filtersActive",
          "group": "1_view@2"
        },
        {
          "command": "wrsync.pickSolution",
          "when": "view == wrsync.webResources && wrsync.signedIn && wrsync.hasEnvironment",
          "group": "2_context@1"
        },
        {
          "command": "wrsync.pickEnvironment",
          "when": "view == wrsync.webResources && wrsync.signedIn",
          "group": "2_context@2"
        },
        {
          "command": "wrsync.signOut",
          "when": "view == wrsync.webResources && wrsync.signedIn",
          "group": "3_account@1"
        }
      ],
      "view/item/context": [
        {
          "command": "wrsync.publishSelected",
          "when": "view == wrsync.webResources && listMultiSelection && wrsync.selectionHasSyncable",
          "group": "1_sync@0"
        },
        {
          "command": "wrsync.link",
          "when": "view == wrsync.webResources && viewItem =~ /;linkable;/",
          "group": "inline@1"
        },
        {
          "command": "wrsync.publish",
          "when": "view == wrsync.webResources && viewItem =~ /;syncable;/",
          "group": "inline@2"
        },
        {
          "command": "wrsync.pull",
          "when": "view == wrsync.webResources && viewItem =~ /;syncable;/",
          "group": "inline@3"
        },
        {
          "command": "wrsync.unlink",
          "when": "view == wrsync.webResources && viewItem =~ /;linked;/",
          "group": "inline@4"
        },
        {
          "command": "wrsync.compare",
          "when": "view == wrsync.webResources && viewItem =~ /;syncable;/",
          "group": "1_sync@1"
        },
        {
          "command": "wrsync.publish",
          "when": "view == wrsync.webResources && viewItem =~ /;syncable;/",
          "group": "1_sync@2"
        },
        {
          "command": "wrsync.pull",
          "when": "view == wrsync.webResources && viewItem =~ /;syncable;/",
          "group": "1_sync@3"
        },
        {
          "command": "wrsync.openLocalFile",
          "when": "view == wrsync.webResources && viewItem =~ /;linked;/",
          "group": "2_link@1"
        },
        {
          "command": "wrsync.link",
          "when": "view == wrsync.webResources && viewItem =~ /;linkable;/",
          "group": "2_link@2"
        },
        {
          "command": "wrsync.unlink",
          "when": "view == wrsync.webResources && viewItem =~ /;linked;/",
          "group": "2_link@3"
        },
        {
          "command": "wrsync.showDetails",
          "when": "view == wrsync.webResources && viewItem =~ /;webresource;/",
          "group": "3_info@1"
        },
        {
          "command": "wrsync.viewContent",
          "when": "view == wrsync.webResources && viewItem =~ /;viewable;/",
          "group": "0_view@1"
        }
      ],
      "commandPalette": [
        {
          "command": "wrsync.viewContent",
          "when": "false"
        },
        {
          "command": "wrsync.link",
          "when": "false"
        },
        {
          "command": "wrsync.unlink",
          "when": "false"
        },
        {
          "command": "wrsync.pull",
          "when": "false"
        },
        {
          "command": "wrsync.compare",
          "when": "false"
        },
        {
          "command": "wrsync.openLocalFile",
          "when": "false"
        },
        {
          "command": "wrsync.showDetails",
          "when": "false"
        },
        {
          "command": "wrsync.showAllNotOnlyModified",
          "when": "false"
        },
        {
          "command": "wrsync.publish",
          "when": "focusedView == wrsync.webResources"
        },
        {
          "command": "wrsync.publishCurrentFile",
          "when": "wrsync.activeFileLinked"
        },
        {
          "command": "wrsync.refresh",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.createWebResource",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.suggestLinks",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.filterTypes",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.filterManaged",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.showModifiedOnly",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.clearFilters",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.sortBy",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.pickSolution",
          "when": "wrsync.signedIn"
        },
        {
          "command": "wrsync.pickEnvironment",
          "when": "wrsync.signedIn"
        },
        {
          "command": "wrsync.signOut",
          "when": "wrsync.signedIn"
        },
        {
          "command": "wrsync.signIn",
          "when": "!wrsync.signedIn"
        },
        {
          "command": "wrsync.signInToTenant",
          "when": "!wrsync.signedIn"
        },
        {
          "command": "wrsync.publishSelected",
          "when": "wrsync.selectionHasSyncable"
        },
        {
          "command": "wrsync.showAllNotOnlyLinked",
          "when": "false"
        },
        {
          "command": "wrsync.showLinkedOnly",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        },
        {
          "command": "wrsync.showAllNotOnlyUnlinked",
          "when": "false"
        },
        {
          "command": "wrsync.showUnlinkedOnly",
          "when": "wrsync.signedIn && wrsync.hasSolution"
        }
      ]
    },
    "keybindings": [
      {
        "command": "wrsync.publishCurrentFile",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && wrsync.activeFileLinked"
      }
    ],
    "viewsWelcome": [
      {
        "view": "wrsync.webResources",
        "when": "!wrsync.signedIn",
        "contents": "Sign in with your Microsoft account to browse and sync Dataverse web resources.\n[Sign In](command:wrsync.signIn)\nEnvironment in another organization? [Sign in to another tenant](command:wrsync.signInToTenant)."
      },
      {
        "view": "wrsync.webResources",
        "when": "wrsync.signedIn && !wrsync.hasEnvironment",
        "contents": "Pick the Dataverse environment to work with.\n[Pick Environment](command:wrsync.pickEnvironment)"
      },
      {
        "view": "wrsync.webResources",
        "when": "wrsync.signedIn && wrsync.hasEnvironment && !wrsync.hasSolution",
        "contents": "Pick the solution whose web resources you want to sync.\n[Pick Solution](command:wrsync.pickSolution)\n[Change Environment](command:wrsync.pickEnvironment)"
      }
    ],
    "submenus": [
      {
        "id": "wrsync.filter",
        "label": "Filter",
        "icon": "$(filter)"
      },
      {
        "id": "wrsync.filterActive",
        "label": "Filter (active)",
        "icon": "$(filter-filled)"
      }
    ]
  },
  "scripts": {
    "postinstall": "npm --prefix webview-ui install",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run build:webview && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "npm --prefix webview-ui run watch",
    "dev:mock": "npm --prefix webview-ui run dev:mock",
    "build:webview": "npm --prefix webview-ui run build",
    "package": "npm run check-types && npm run lint && npm run build:webview && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.135.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0"
  }
}
