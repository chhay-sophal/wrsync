{
  "name": "wrsync",
  "displayName": "Web Resource Sync",
  "description": "Edit Power Apps (Dataverse) web resources from local files, right inside VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wrsync.signIn",
        "title": "Web Resource Sync: Sign In"
      },
      {
        "command": "wrsync.signOut",
        "title": "Web Resource Sync: Sign Out"
      },
      {
        "command": "wrsync.showAuthStatus",
        "title": "Web Resource Sync: Show Sign-in Status"
      },
      {
        "command": "wrsync.pickEnvironment",
        "title": "Web Resource Sync: Pick Environment"
      },
      {
        "command": "wrsync.browseWebResources",
        "title": "Web Resource Sync: Browse Web Resources"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.135.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0"
  }
}
